# Copy to .env and adjust. Never commit the real .env.

# --- Django -------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:18300
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False

# --- Database -----------------------------------------------------------------
# Omit to fall back to SQLite (db.sqlite3). docker-compose overrides this.
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
CONN_MAX_AGE=60

# --- API ----------------------------------------------------------------------
PAGE_SIZE=20
THROTTLE_ANON=100/min
THROTTLE_USER=1000/min
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Email (console backend prints codes to stdout) ----------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Media --------------------------------------------------------------------
# MEDIA_ROOT=/app/media

# --- Click (SHOP-API) -----------------------------------------------------------
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Payme (Merchant API) ------------------------------------------------------
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_ACCOUNT_FIELD=order_id
# Sandbox: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Where providers send the customer after payment (optional)
PAYMENT_RETURN_URL=
